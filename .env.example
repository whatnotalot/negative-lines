# Copy to .env (gitignored) and fill in locally. Never commit real keys.
#
# Only secrets and the profile choice belong here. Provider, model, temperature,
# structured-output method, rate limit etc. are declared per profile in
# config/llm.yaml; to try another model, edit or add a profile there.

# Active profile from config/llm.yaml: openai_mini | gemini_flash | gemini_flash_lite
NL_LLM_PROFILE=openai_mini

# API key for the active profile's provider (the profile's api_key_env names it)
OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
